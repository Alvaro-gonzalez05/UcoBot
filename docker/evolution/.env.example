# Copiar a .env y completar. NO commitear el .env real.

# API key global de Evolution. Generá una larga y aleatoria, p. ej.:
#   PowerShell:  -join ((48..57)+(97..122) | Get-Random -Count 48 | % {[char]$_})
EVOLUTION_API_KEY=CAMBIAME-por-una-clave-larga-aleatoria

# Password del Postgres interno de Evolution (solo lo usa el contenedor)
POSTGRES_PASSWORD=CAMBIAME-tambien

# Webhook hacia UcoBot corriendo local (npm run dev en el puerto 3000).
# `host.docker.internal` es tu máquina vista desde dentro de Docker.
UCOBOT_WEBHOOK_URL=http://host.docker.internal:3000/api/whatsapp/evolution/webhook
